[Unit]
Description=Rako local mobile API
Documentation=https://github.com/yungzyx/rako-pi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yunglab
Group=yunglab
WorkingDirectory=/home/yunglab/rako-pi
Environment="PYTHONPATH=/home/yunglab/rako-pi/src"
EnvironmentFile=-/home/yunglab/rako-pi/.env
ExecStart=/home/yunglab/rako-pi/scripts/rako-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rako-api

[Install]
WantedBy=multi-user.target

