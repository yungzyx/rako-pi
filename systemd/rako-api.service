[Unit]
Description=Rako local mobile API
Documentation=https://github.com/yungzyx/rako-pi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RAKO_USER__
Group=__RAKO_USER__
WorkingDirectory=__RAKO_DIR__
Environment="PYTHONPATH=__RAKO_DIR__/src"
EnvironmentFile=-__RAKO_DIR__/.env
ExecStart=__RAKO_DIR__/scripts/rako-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rako-api

[Install]
WantedBy=multi-user.target
