[Unit]
Description=Rako physical button chat loop
Documentation=https://github.com/yungzyx/rako-pi
After=network-online.target sound.target
Wants=network-online.target
# rako.service y rako-chat.service compiten por el botón GPIO y el audio:
# instalar solo uno de los dos.
Conflicts=rako.service

[Service]
Type=simple
User=__RAKO_USER__
Group=__RAKO_USER__
WorkingDirectory=__RAKO_DIR__
Environment="PYTHONPATH=__RAKO_DIR__/src"
Environment="RAKO_OLED=1"
EnvironmentFile=-__RAKO_DIR__/.env
ExecStart=__RAKO_DIR__/scripts/rako-chat
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Needs GPIO/I2C/sound access on the Pi. Keep hardening light until hardware is stable.
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rako-chat

[Install]
WantedBy=multi-user.target
