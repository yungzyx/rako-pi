[Unit]
Description=Rako — Asistente físico de acompañamiento emocional
Documentation=https://github.com/yungzyx/rako-pi
After=network-online.target sound.target
Wants=network-online.target
# rako.service y rako-chat.service compiten por el botón GPIO y el audio:
# instalar solo uno de los dos.
Conflicts=rako-chat.service

[Service]
Type=simple
User=__RAKO_USER__
Group=__RAKO_USER__
WorkingDirectory=__RAKO_DIR__
Environment="PYTHONPATH=__RAKO_DIR__/src"
EnvironmentFile=__RAKO_DIR__/.env

# Comando principal — loop continuo reactivo a hardware events.
# `run` se suscribe al HardwareEventBus y procesa TOUCH / BUTTON_PANIC
# como turns; drena la cola de sync periódicamente.
ExecStart=__RAKO_DIR__/.venv/bin/python -m main run

# Reinicio sólido: si falla, esperar 10s y volver a arrancar.
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

# Hardening — limitar superficie de ataque.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__RAKO_DIR__/data __RAKO_DIR__/chroma_db __RAKO_DIR__/logs
PrivateTmp=true
PrivateDevices=false
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/snd rw
DeviceAllow=char-ttyAMA0 rw

# Logs vía journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rako

[Install]
WantedBy=multi-user.target
