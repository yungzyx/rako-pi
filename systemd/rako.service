[Unit]
Description=Rako — Asistente físico de acompañamiento emocional
Documentation=https://github.com/yungzyx/rako-pi
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=rako
Group=rako
WorkingDirectory=/home/rako/rako-pi
Environment="PYTHONPATH=/home/rako/rako-pi/src"
EnvironmentFile=/home/rako/rako-pi/.env

# Comando principal — loop continuo reactivo a hardware events.
# `run` se suscribe al HardwareEventBus y procesa TOUCH / BUTTON_PANIC
# como turns; drena la cola de sync periódicamente.
ExecStart=/home/rako/rako-pi/.venv/bin/python -m main run

# Reinicio sólido: si falla, esperar 10s y volver a arrancar.
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

# Hardening — limitar superficie de ataque.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rako/rako-pi/data /home/rako/rako-pi/chroma_db /home/rako/rako-pi/logs
PrivateTmp=true
PrivateDevices=false
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/snd rw
DeviceAllow=char-ttyAMA0 rw

# Logs vía journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rako

[Install]
WantedBy=multi-user.target
