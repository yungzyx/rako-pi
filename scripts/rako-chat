#!/usr/bin/env bash
# Start the physical Rako chat loop: OLED idle eyes + ReSpeaker button listener.
# Extra args are passed to scripts/button_conversation.py.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "${SCRIPT_PATH}")"
fi
ROOT="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
PYTHON="${ROOT}/.venv/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  PYTHON="python3"
fi

export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
cd "${ROOT}"

for arg in "$@"; do
  if [[ "${arg}" == "--help" || "${arg}" == "-h" ]]; then
    exec "${PYTHON}" -u scripts/button_conversation.py "$@"
  fi
done

if [[ "${RAKO_AUDIO_SETUP:-1}" != "0" && -x scripts/setup_respeaker_audio.sh ]]; then
  scripts/setup_respeaker_audio.sh >/tmp/rako-audio-setup.log 2>&1 || {
    echo "Warning: ReSpeaker audio setup failed. See /tmp/rako-audio-setup.log"
  }
fi

if [[ "${RAKO_DOCTOR:-1}" != "0" ]]; then
  echo "Checking Rako readiness..."
  if ! scripts/rako-doctor; then
    echo "Rako readiness check failed. Fix blockers or run RAKO_DOCTOR=0 rako-chat to bypass."
    exit 1
  fi
fi

OLED_ARGS=()
if [[ "${RAKO_OLED:-1}" != "0" ]]; then
  OLED_ARGS=("--oled")
  echo "Rako OLED expressions enabled. Set RAKO_OLED=0 to disable."
fi

echo "Starting Rako button chat. Press Ctrl+C to stop."
exec "${PYTHON}" -u scripts/button_conversation.py "${OLED_ARGS[@]}" "$@"
