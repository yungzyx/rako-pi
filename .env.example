# Rako — variables de entorno (plantilla)
#
# Copiar a `.env` y rellenar. NUNCA commitear `.env`.
# El cargador (pydantic-settings) leerá esto al iniciar el servicio.

# =========================================================================
# Núcleo
# =========================================================================
RAKO_ENV=dev                 # dev | staging | prod
RAKO_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
RAKO_DEVICE_ID=              # ID único de esta Pi (generar al provisionar)
RAKO_API_TOKEN=              # obligatorio en staging/prod para API local

# =========================================================================
# LLM — OpenAI principal, Anthropic fallback/opcional
# =========================================================================
LLM_PROVIDER=openai               # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=512
ANTHROPIC_TIMEOUT_S=15
# Modo no-training siempre on en producción (verificar en consola Anthropic).

# =========================================================================
# Voz — STT + ElevenLabs/Google TTS
# =========================================================================
# STT recomendado para conversación: openai_whisper. Google queda disponible
# como fallback. Para wakeword usar Porcupine/openWakeWord, no STT textual.
STT_PROVIDER=google                # google | openai_whisper
OPENAI_STT_MODEL=whisper-1
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_STT_LANGUAGE=es-CL

# TTS principal recomendado: ElevenLabs (voz más cálida/expresiva).
# Si falta ELEVENLABS_API_KEY, Rako cae a Google TTS; si Google tampoco
# está configurado, cae al TTS canned de dev para no crashear.
TTS_PROVIDER=elevenlabs             # elevenlabs | google
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.8

GOOGLE_TTS_VOICE=es-CL-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=0.95

# Alternativa Azure (si se cambia de proveedor)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# =========================================================================
# RAG — ChromaDB
# =========================================================================
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=rako_kb
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
# Ruta a la vault de Obsidian (fuera del repo, en ../Rako-kb)
OBSIDIAN_VAULT_PATH=../Rako-kb

# =========================================================================
# SER — detección emocional local
# =========================================================================
SER_MODEL=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
SER_DEVICE=cpu               # cpu en Pi 4
SER_QUANTIZED=true

# =========================================================================
# Wake word
# =========================================================================
# Producto recomendado: porcupine con keyword custom .ppn para "Oye Rako".
# Fallback dev: text_stt usa Google STT y puede confundir Rako con gato/flaco/etc.
WAKE_WORD_ENGINE=text_stt          # text_stt | porcupine
WAKE_WORDS=hey rako,hola rako,oye rako
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=./models/oye-rako.ppn
PORCUPINE_SENSITIVITY=0.65

# =========================================================================
# Estado local — SQLite cifrado (SQLCipher)
# =========================================================================
SQLITE_PATH=./data/rako.db
# Generar con `openssl rand -hex 32` y guardar fuera del repo.
SQLITE_ENCRYPTION_KEY=

# =========================================================================
# Setup local — WiFi, hotspot y API de primer encendido
# =========================================================================
# Rako puede guardar SSID sin clave. Solo ejecuta nmcli con este flag activo.
RAKO_WIFI_APPLY_ENABLED=false
# Hotspot de primer encendido. El plan aparece en GET /setup/hotspot/plan.
RAKO_SETUP_HOTSPOT_ENABLED=false
RAKO_SETUP_HOTSPOT_SSID_PREFIX=Rako-Setup
RAKO_SETUP_HOTSPOT_INTERFACE=wlan0
RAKO_SETUP_HOTSPOT_URL=http://10.42.0.1:8765/setup

# =========================================================================
# WhatsApp — cliente local o Meta Cloud API
# =========================================================================
WHATSAPP_CLIENT=memory       # memory | cloud
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_TIMEOUT_S=10

# =========================================================================
# OTA — planificación segura de actualizaciones
# =========================================================================
RAKO_RELEASE_CHANNEL=stable  # stable | beta | dev
RAKO_UPDATE_MANIFEST_PATH=
RAKO_UPDATE_PUBLIC_KEY_PATH=
RAKO_UPDATE_APPLY_ENABLED=false

# =========================================================================
# Sync — Firebase
# =========================================================================
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=
FIREBASE_REALTIME_DB_URL=

# =========================================================================
# Hardware — GPIO pinout (BCM)
# =========================================================================
GPIO_LED_RING_PIN=18
GPIO_LED_EYES_LEFT_CS=8
GPIO_LED_EYES_RIGHT_CS=7
GPIO_SERVO_HEAD_PIN=12
GPIO_SERVO_EAR_PIN=13
GPIO_PIR_PIN=23
GPIO_TOUCH_PIN=24
GPIO_BUTTON_PANIC_PIN=17
GPIO_BUTTON_EMERGENCY_PIN=27

# Audio I/O
AUDIO_INPUT_DEVICE=         # nombre del mic USB (vacío = default)
AUDIO_OUTPUT_DEVICE=

# =========================================================================
# Seguridad / crisis
# =========================================================================
# Recursos Chile cargados en src/safety/resources.py; aquí solo overrides.
CRISIS_HELPLINE_OVERRIDE=
EMERGENCY_SMS_GATEWAY=

# =========================================================================
# Modos
# =========================================================================
# offline: sin cloud (RAG y respuestas pre-curadas únicamente).
# private: opera pero no guarda historial.
RAKO_MODE=normal             # normal | offline | private
DO_NOT_DISTURB_START=22:00
DO_NOT_DISTURB_END=08:00
