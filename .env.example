# Rako — variables de entorno (plantilla)
#
# Copiar a `.env` y rellenar. NUNCA commitear `.env`.
# El cargador (pydantic-settings) leerá esto al iniciar el servicio.

# =========================================================================
# Núcleo
# =========================================================================
RAKO_ENV=dev                 # dev | staging | prod
RAKO_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
RAKO_DEVICE_ID=              # ID único de esta Pi (generar al provisionar)

# =========================================================================
# LLM — Anthropic Claude
# =========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=512
# Modo no-training siempre on en producción (verificar en consola Anthropic).

# =========================================================================
# Voz — Google Cloud Speech (STT + TTS)
# =========================================================================
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_STT_LANGUAGE=es-CL
GOOGLE_TTS_VOICE=es-CL-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=0.95

# Alternativa Azure (si se cambia de proveedor)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# =========================================================================
# RAG — ChromaDB
# =========================================================================
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=rako_kb
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
# Ruta a la vault de Obsidian (fuera del repo, en ../Rako-kb)
OBSIDIAN_VAULT_PATH=../Rako-kb

# =========================================================================
# SER — detección emocional local
# =========================================================================
SER_MODEL=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
SER_DEVICE=cpu               # cpu en Pi 4
SER_QUANTIZED=true

# =========================================================================
# Wake word
# =========================================================================
WAKE_WORDS=hey rako,hola rako,oye rako
# PORCUPINE_ACCESS_KEY=

# =========================================================================
# Estado local — SQLite cifrado (SQLCipher)
# =========================================================================
SQLITE_PATH=./data/rako.db
# Generar con `openssl rand -hex 32` y guardar fuera del repo.
SQLITE_ENCRYPTION_KEY=

# =========================================================================
# Sync — Firebase
# =========================================================================
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=
FIREBASE_REALTIME_DB_URL=

# =========================================================================
# Hardware — GPIO pinout (BCM)
# =========================================================================
GPIO_LED_RING_PIN=18
GPIO_LED_EYES_LEFT_CS=8
GPIO_LED_EYES_RIGHT_CS=7
GPIO_SERVO_HEAD_PIN=12
GPIO_SERVO_EAR_PIN=13
GPIO_PIR_PIN=23
GPIO_TOUCH_PIN=24
GPIO_BUTTON_PANIC_PIN=17
GPIO_BUTTON_EMERGENCY_PIN=27

# Audio I/O
AUDIO_INPUT_DEVICE=         # nombre del mic USB (vacío = default)
AUDIO_OUTPUT_DEVICE=

# =========================================================================
# Seguridad / crisis
# =========================================================================
# Recursos Chile cargados en src/safety/resources.py; aquí solo overrides.
CRISIS_HELPLINE_OVERRIDE=
EMERGENCY_SMS_GATEWAY=

# =========================================================================
# Modos
# =========================================================================
# offline: sin cloud (RAG y respuestas pre-curadas únicamente).
# private: opera pero no guarda historial.
RAKO_MODE=normal             # normal | offline | private
DO_NOT_DISTURB_START=22:00
DO_NOT_DISTURB_END=08:00
